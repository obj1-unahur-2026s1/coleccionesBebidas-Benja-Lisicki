import bebidas.*
import tito.*
import frutas.*

describe "Tests de Tito" {
  test "Tito consume 250 de licuado de frutas echo con manzana y naranja y su velocidad es 262.5" {
    licuadoDeFrutas.agregarFruta(manzana)
    licuadoDeFrutas.agregarFruta(naranja)
    tito.consumir(250, licuadoDeFrutas)
    assert.equals(262.5, tito.velocidad())
    
    }

    test "tito consume 50 de un coctel de whisky y agua saborizada con whisky y su velocidad es 0.76" {
      aguaSaborizada.saborizar(whisky)
      coctel.agregarBebida(whisky)
      coctel.agregarBebida(aguaSaborizada)
      tito.consumir(50, coctel)
    assert.equals(0.76265, tito.velocidad())
    
    }

}



